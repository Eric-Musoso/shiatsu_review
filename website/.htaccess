# Shiatsu Kolczewski – neue Website (November 2026)
# Liegt im Hauptordner der Website. Die alte WordPress-Seite bleibt unverändert im Ordner /wordpress.

# Eigene Fehlerseite für Adressen, die es nicht mehr gibt
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Immer https://www.shiatsu-kolczewski.de verwenden (gilt nur für diese Domain)
RewriteCond %{HTTP_HOST} ^(www\.)?shiatsu-kolczewski\.de$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{ENV:HTTPS} !=on
RewriteRule ^ https://www.shiatsu-kolczewski.de%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^shiatsu-kolczewski\.de$ [NC]
RewriteRule ^ https://www.shiatsu-kolczewski.de%{REQUEST_URI} [R=301,L]

# Alte WordPress-Adressen dauerhaft auf die passenden Abschnitte der neuen Seite umleiten
RewriteRule ^ueber-mich/?$ https://www.shiatsu-kolczewski.de/#ueber [R=301,NE,L]
RewriteRule ^shiatsu-behandlung/?$ https://www.shiatsu-kolczewski.de/#behandlung [R=301,NE,L]
RewriteRule ^preise/?$ https://www.shiatsu-kolczewski.de/#preise [R=301,NE,L]
RewriteRule ^termin/?$ https://www.shiatsu-kolczewski.de/#kontakt [R=301,NE,L]
RewriteRule ^kontakt/?$ https://www.shiatsu-kolczewski.de/#kontakt [R=301,NE,L]
RewriteRule ^blog(/.*)?$ https://www.shiatsu-kolczewski.de/ [R=301,L]
RewriteRule ^feed/?$ https://www.shiatsu-kolczewski.de/ [R=301,L]
</IfModule>

# Bilder, Schriften und Film länger im Browser zwischenspeichern (schnellere Seite)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/x-icon "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType video/mp4 "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
<IfModule mod_filter.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml image/svg+xml
</IfModule>
</IfModule>

<IfModule mod_mime.c>
AddType font/woff2 .woff2
</IfModule>
